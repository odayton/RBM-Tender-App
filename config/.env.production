# RBM Tender App - Production Environment (EC2)
# Copy this file to .env and update with your actual values

# Flask Environment
FLASK_ENV=production

# Database Configuration (PostgreSQL on EC2)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://odayton:MadeInItaly1953!@localhost:5432/rbm_tender_app

# Security
SECRET_KEY=eq_GfRcYZaSnGTydWD6Vadqta_ktqNCpC47PYUWlKEE

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Logging
LOG_LEVEL=INFO

# Domain (for Cloudflare)
DOMAIN=rbm-intranet.com

# Optional: Redis for caching (if you want to add it later)
# REDIS_URL=redis://localhost:6379/0

# SMTP Configuration (for later - password resets, notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true

# Application Settings
SECURITY_MAX_LOGIN_ATTEMPTS=10
SECURITY_BLOCK_DURATION_MINUTES=15
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
PERMANENT_SESSION_LIFETIME=3600

# File Upload Settings (if needed later)
# MAX_CONTENT_LENGTH=16777216
# UPLOAD_FOLDER=uploads
# ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif

# Monitoring and Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300

