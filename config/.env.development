# RBM Tender App - Development Environment (Local)
# Copy this file to .env for local development

# Flask Environment
FLASK_ENV=development

# Database Configuration (SQLite for local development)
DATABASE_URL=sqlite:///app/instance/rbm_tender_app_local.db

# Security (use different key for development)
SECRET_KEY=p-uZOo3veUMucTIziIW5Ay2imQ_-5m4PApCtnxW36DI

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Logging (more verbose for development)
LOG_LEVEL=DEBUG

# Domain (localhost for development)
DOMAIN=localhost:5000

# Optional: Redis for caching
# REDIS_URL=redis://localhost:6379/0

# SMTP Configuration (for development testing)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true

# Application Settings (development-friendly)
SECURITY_MAX_LOGIN_ATTEMPTS=50
SECURITY_BLOCK_DURATION_MINUTES=5
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
PERMANENT_SESSION_LIFETIME=7200

# File Upload Settings
# MAX_CONTENT_LENGTH=16777216
# UPLOAD_FOLDER=uploads
# ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif

# Development Features
DEBUG=true
TESTING=false
DEVELOPMENT_MODE=true
AUTO_LOGIN=true