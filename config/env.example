# RBM Tender App - Environment Configuration
# Copy this file to .env and update with your values
# 
# 🔐 SECURITY NOTICE: This file contains sensitive information!
# - Never commit .env files to version control
# - Use strong, unique values for all secrets
# - Rotate secrets regularly in production

# =============================================================================
# APPLICATION SECURITY (CRITICAL - MUST BE SET)
# =============================================================================

# ⚠️  CRITICAL: Generate a secure secret key (minimum 32 characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your_super_secure_secret_key_here_minimum_32_characters

# API Key for external integrations (auto-generated if not set)
# API_KEY=rbm_your_api_key_here

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment: development, testing, production
FLASK_ENV=development

# Server configuration
HOST=0.0.0.0
PORT=5000

# Debug mode (NEVER set to True in production)
DEBUG=False

# =============================================================================
# MONITORING & ERROR TRACKING
# =============================================================================

# Sentry DSN for error tracking (optional)
# Get your DSN from https://sentry.io/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry release version (optional)
# SENTRY_RELEASE=1.0.0

# =============================================================================
# DATABASE CONFIGURATION (CRITICAL - MUST BE SET)
# =============================================================================

# Development Database (PostgreSQL)
# ⚠️  REQUIRED: Update with your actual database credentials
DEV_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/rbm_tender_app

# Production Database (PostgreSQL)
# ⚠️  REQUIRED: Update with your actual database credentials
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/rbm_tender_app

# Test Database (PostgreSQL)
# ⚠️  OPTIONAL: For testing environment
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/rbm_tender_app_test

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Login security
SECURITY_MAX_LOGIN_ATTEMPTS=10
SECURITY_BLOCK_DURATION_MINUTES=15

# Session security
SESSION_TIMEOUT_HOURS=8

# Rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH_ENDPOINTS=5
RATE_LIMIT_ADMIN_ENDPOINTS=20

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (relative to instance directory)
LOG_FILE=logs/app.log

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# =============================================================================

# Email settings for password resets and notifications
# ⚠️  REPLACE THESE: Update with your actual email credentials
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_here
SMTP_PASSWORD=your_email_password_here
SMTP_USE_TLS=True

# Email sender information
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
MAIL_SUPPRESS_SEND=False

# =============================================================================
# CACHING CONFIGURATION (OPTIONAL)
# =============================================================================

# Redis for caching (if available)
# REDIS_URL=redis://localhost:6379/0

# Cache settings
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=rbm_cache:

# =============================================================================
# MONITORING & ANALYTICS (OPTIONAL)
# =============================================================================

# Application monitoring
ENABLE_MONITORING=False
MONITORING_ENDPOINT=https://your-monitoring-service.com

# Error tracking
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file upload size (in bytes)
MAX_CONTENT_LENGTH=16777216

# Allowed file extensions
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif,doc,docx,xls,xlsx

# Upload directory (relative to instance directory)
UPLOAD_FOLDER=uploads

# =============================================================================
# BACKUP CONFIGURATION (OPTIONAL)
# =============================================================================

# Backup settings
BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=daily

# Backup storage location
BACKUP_DIR=backups

# =============================================================================
# DEVELOPMENT ONLY SETTINGS
# =============================================================================

# Auto-login for development (NEVER enable in production)
ENABLE_AUTO_LOGIN=False

# Development database auto-reload
SQLALCHEMY_TRACK_MODIFICATIONS=False 