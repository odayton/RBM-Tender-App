# RBM Tender App - Production Environment Configuration
# Copy this file to .env and update with your values

# Application Security
# ⚠️  REPLACE THIS: Generate a secure secret key
SECRET_KEY=your_super_secure_secret_key_here

# Environment
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000

# Database Configuration (PostgreSQL)
# ⚠️  REPLACE THESE: Update with your actual database credentials
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/rbm_tender_app

# Logging
LOG_LEVEL=INFO

# Optional: Email configuration (for password resets)
# ⚠️  REPLACE THESE: Update with your actual email credentials
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email_here
SMTP_PASSWORD=your_email_password_here

# Optional: Redis for caching (if available)
# REDIS_URL=redis://localhost:6379/0 